{% extends 'base.html.twig' %}
{% block body %}
<h2>Liste des Jobs| <small> <a href="{{ path('ajout_job')}}">Ajouter</a>
</small></h2>
<table class="table table-hover table-striped" border="1">
<thead>
<tr>
<th>#</th>
<th>Nom & Prenom</th>
<th>Date</th>
<th>Contenu</th>
<th></th>
</tr>
</thead>
<tbody>
{% for job in lesjobs %}
<tr>
<td>{{ job.id }}</td>
<td>{{ job.candidat | upper}} </td>
<td>{{ job.date | date('d/m/yy')}} </td>
<td>{{ job.contenu }}</td>
<td>
<a class="btn btn-primary" href="#">voir</a>
<a class="btn btn-success" href="#"> Modifier</a>
<a class="btn btn-danger" href="#">Supprimer</a>
</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endblock %}
